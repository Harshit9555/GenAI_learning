   "source": [
    "total_sales = 0\n",
    "daily = [200,150,0,400,50,-1,300]\n",
    "for day in daily:\n",
    "    if day == -1:\n",
    "        break\n",
    "    elif day == 0:\n",
    "        continue\n",
    "    else:\n",
    "        total_sales += day\n",
    "        print(total_sales)\n",
    "print(f\"Total sales are : {total_sales}\")\n",
    "        "
   ]
  }
